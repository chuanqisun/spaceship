{
  "name": "spaceship-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:bundle": "node scripts/check-bundle-secrets.mjs",
    "check:speckit": "node scripts/check-speckit-hardening.mjs",
    "pretest:e2e": "playwright-core install chromium",
    "test:e2e": "vitest run --project e2e",
    "check": "npm run format:check && npm run check:speckit && npm run typecheck && npm test && npm run test:e2e && npm run build && npm run check:bundle"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "playwright-core": "^1.65.1",
    "prettier": "^3.10.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@chenglou/pretext": "^1.0.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0"
  }
}
